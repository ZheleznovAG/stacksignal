# Optional: enables real AI-backed enrichment (summaries, relevance scoring,
# opportunities, chat) via a separate AI Gateway service you run yourself — StackSignal
# has no model/provider SDK of its own, only an HTTP client for this gateway's API.
# Without it, StackSignal falls back to heuristic keyword-based scoring and a plain
# keyword-match listing for chat.
AI_BASE_URL=http://127.0.0.1:8787
AI_API_KEY=

# On Windows, if AI_API_KEY is left blank and AI_BASE_URL is left at its default above,
# config.py also checks the GATEWAY_API_KEY user environment variable (via the
# registry) as a convenience, in case a local gateway launcher already publishes its
# key there. Set AI_API_KEY explicitly to opt out of that fallback.

# Per-request timeout (seconds) the AIClient enforces end-to-end, including polling.
AI_TIMEOUT=330
# Timeout (ms) sent to the gateway itself in the request body. The gateway silently clamps it to
# its own GATEWAY_TIMEOUT_MS (default 180000), so start the gateway with GATEWAY_TIMEOUT_MS at
# least this large. A batch is one long generation, not many short ones.
AI_REQUEST_TIMEOUT_MS=300000
# Hard cap on real gateway calls per collection run. Two are held back for the end of the run
# (opportunities and capability consolidation); the rest go to batched item analysis, so the
# defaults analyse (6 - 2) x AI_BATCH_SIZE = 20 items per run.
AI_MAX_CALLS_PER_RUN=6
# Items analysed per gateway call (1-20). A call costs a fixed ~20-40s of browser time plus
# generation time proportional to its output, so batches of ~5 raise AI coverage per run
# several-fold; much larger batches risk exceeding the gateway timeout.
AI_BATCH_SIZE=5
# Items per relevance-only call (used after you edit a project: only its relevance is redone).
AI_RELEVANCE_BATCH_SIZE=10
# Set to 0 to force heuristic mode everywhere even with a key/gateway configured.
AI_ENABLED=0

# Optional: raises GitHub API rate limits from 60/hr to 5000/hr. Create at
# https://github.com/settings/tokens (no scopes needed, public read access only).
GITHUB_TOKEN=
# Optional: your GitHub login. Repositories you star are added to the radar as Watch, and the
# owners of starred repositories and the people you follow become watched authors.
# GITHUB_LOGIN=
# How deep and how often project searches go (defaults are sized for a token; without one they are smaller).
# GITHUB_QUERIES_PER_RUN=24
# GITHUB_SEARCH_PAGES=3
# GITHUB_SEARCH_PAUSE=2.2
# HF_QUERIES_PER_RUN=24
# REFRESH_GITHUB_PER_RUN=100
# STALE_DAYS=30

# How many days back to look for "new" items during collection.
COLLECT_WINDOW_DAYS=30

# --- Daily run and Telegram digest --------------------------------------------------------
# Local time of the automatic daily collection (the digest is sent right after it). The
# computer and StackSignal must be running at that time; otherwise use "Run collection now".
DAILY_RUN_TIME=08:00
# Telegram digest. Create a bot with @BotFather (/newbot) to get the token, press Start in your
# bot, then use the Digest tab's "Find my chat id" button for TELEGRAM_CHAT_ID. Restart afterwards.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only if Telegram is blocked on your network, e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:10809
TELEGRAM_PROXY=
# ru or en: language of the digest's own words (item texts come from the AI in English).
DIGEST_LANG=ru
# Language of the AI-written texts (summaries, reasons, briefings). Terms and names stay in English.
# ru or en. Changing it makes items get re-analysed in the new language over the next runs.
AI_TEXT_LANG=ru
# An item is included only if the AI scored it at least this relevant (0..1), at most this many
# per digest (at most 3 per project). Nothing new and relevant means no message.
DIGEST_MIN_RELEVANCE=0.6
DIGEST_MAX_ITEMS=8
# 0 switches the digest off while keeping the daily run.
DIGEST_ENABLED=1
# The link at the bottom of the digest.
DASHBOARD_URL=http://localhost:8000
